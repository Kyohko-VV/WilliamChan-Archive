---
import { events } from "../../data/events";
import { buildTimeline, timelinePageHref } from "../../utils/timeline";
import FooterSocialLinks from "../FooterSocialLinks.astro";
import SeoHead from "../SeoHead.astro";

interface Props { year?: string; page?: number; }
const timeline = buildTimeline(events);
const year = Astro.props.year;
const page = Astro.props.page ?? 1;
const { events: visibleEvents, groups } = year ? timeline.forYear(year) : timeline.forPage(page);
const yearGroups = timeline.years.map((entry) => ({ year: entry, groups: timeline.forYear(entry).groups }));
const title = year ? `${year} 年時間線 | 陳偉霆資料庫`
  : page === 1 ? "最新時間線 | 陳偉霆資料庫" : `時間線・第 ${page} 頁 | 陳偉霆資料庫`;
const description = year
  ? `整理陳偉霆（William Chan）${year} 年的演藝時間線，共 ${visibleEvents.length} 件事件，收錄演藝紀錄與相關可靠來源。`
  : `陳偉霆（William Chan）演藝時間線第 ${page} 頁，依日期由新到舊收錄 ${visibleEvents.length} 件完整事件${visibleEvents.length ? `，涵蓋 ${visibleEvents.at(-1)!.date} 至 ${visibleEvents[0].date}` : ""}，包含圖片、活動紀錄與相關來源。`;
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <SeoHead
      title={title}
      description={description}
    />
  </head>

<body>
  <main data-anchor-years={JSON.stringify(timeline.anchorYears)} data-current-year={year ?? ""}>
    <a href="/" class="back">← 返回首頁</a>

    <header>
      <h1>{year || page === 1 ? "時間線" : `時間線・第 ${page} 頁`}</h1>
      <p>William Chan Archive · Timeline</p>
    </header>

    <nav class="year-navigation" aria-label="時間線年份">
      <div class="date-control">
      <label for="timeline-year">瀏覽年份</label>
      <select id="timeline-year" aria-describedby="year-summary">
        {!year && <option value="/timeline/" selected>全部年份</option>}
        {timeline.years.map((entry) => <option value={`/timeline/${entry}/`} selected={entry === year}>{entry} 年</option>)}
      </select>
      </div>
      <div class="date-control">
      <label for="timeline-month">前往月份</label>
      <select id="timeline-month" aria-describedby="year-summary">
        <option value="">選擇年月</option>
        {yearGroups.map((entry) => <optgroup label={`${entry.year} 年`}>
          {entry.groups.map((group) => <option value={`/timeline/${entry.year}/#month-${group.month || "unknown"}`}>{entry.year} 年 {group.label}</option>)}
        </optgroup>)}
      </select>
      </div>
    </nav>
    <h2 id="year-summary">{year ? `${year} 年` : page === 1 ? "最新紀錄" : `第 ${page} 頁`} <span>{year ? `共 ${visibleEvents.length} 件事件` : `共 ${timeline.events.length} 件事件・第 ${page} / ${timeline.pageCount} 頁`}</span></h2>
    {year ? <>
    <noscript><p>選擇年份：{timeline.years.map((entry) => <a class="year-link" href={`/timeline/${entry}/`}>{entry} 年</a>)}</p></noscript>
    </> : <details class="date-navigation">
      <summary>按年份與月份瀏覽</summary>
      <nav aria-label="時間線年月入口">
        {yearGroups.map((entry) => <p>
          <a class="year-link" href={`/timeline/${entry.year}/`}>{entry.year} 年</a>
          {entry.groups.map((group) => <a class="year-link" href={`/timeline/${entry.year}/#month-${group.month || "unknown"}`}>{group.label}</a>)}
        </p>)}
      </nav>
    </details>}

{groups.map(({ year: groupYear, month, label, events: monthEvents }) => (
    <section class="month-group" aria-labelledby={`month-${year ? "" : `${groupYear}-`}${month || "unknown"}`}>
      <h3 class="month-title" id={`month-${year ? "" : `${groupYear}-`}${month || "unknown"}`}>{year ? label : `${groupYear} 年 ${label}`}</h3>

      {monthEvents.map((event) => {
        const content = (
          <article id={event.id ?? event.anchor} data-event-date={event.date}>
            {event.anchor && event.id && event.anchor !== event.id && <span id={event.anchor} />}
            <strong><time datetime={event.date}>{event.date}</time></strong>
            <h4>{event.href ? <a class="event-link" href={event.href}>{event.title}</a> : event.title}</h4>
            {event.description && <p>{event.description}</p>}
            {event.image && (
              <figure class="timeline-image">
                <img src={event.image} alt={event.imageAlt} loading="lazy" decoding="async" />
                <figcaption>圖片來源：{event.imageSource}</figcaption>
              </figure>
            )}
            {event.sourceUrl && event.source && (
              <a class="detail-link" href={event.sourceUrl} target="_blank" rel="noopener noreferrer">
                來源：{event.source}{event.sourceType && `｜${event.sourceType}`} →
              </a>
            )}
            {event.source && !event.sourceUrl && <p>來源：{event.source}</p>}
            {event.href && <a class="detail-link" href={event.href}>查看事件詳情 →</a>}
            {event.officialMvUrl && <p><a class="detail-link" href={event.officialMvUrl} target="_blank" rel="noopener noreferrer">Official MV｜YouTube →</a></p>}
            {event.additionalSources?.map((source) => <p><a class="detail-link" href={source.url} target="_blank" rel="noopener noreferrer">來源：{source.label} →</a></p>)}
            {event.relatedHref && (
              <a class="detail-link" href={event.relatedHref}>{event.relatedLabel}</a>
            )}
          </article>
        );

        return content;
      })}
    </section>
  ))}
    {!year && timeline.pageCount > 1 && <nav class="pagination" aria-label="時間線分頁">
      {page > 1 ? <a class="year-link" href={timelinePageHref(page - 1)} rel="prev">← 上一頁</a> : <span aria-disabled="true">← 上一頁</span>}
      {Array.from({ length: timeline.pageCount }, (_, index) => index + 1).map((entry) =>
        entry === page ? <span aria-current="page">{entry}</span> : <a class="year-link" href={timelinePageHref(entry)} aria-label={`第 ${entry} 頁`}>{entry}</a>
      )}
      {page < timeline.pageCount ? <a class="year-link" href={timelinePageHref(page + 1)} rel="next">下一頁 →</a> : <span aria-disabled="true">下一頁 →</span>}
    </nav>}
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">陳偉霆資料庫 · William Chan Archive</p>
        <FooterSocialLinks />
        <p class="footer-nav">Timeline ｜ Works ｜ People &amp; Characters ｜ Sources ｜ <a class="footer-feedback" href="https://lounge.williamchanfanpage.com/feedback">Feedback</a></p>
        <p>非官方粉絲資料庫</p>
        <p>本站內容僅作資料整理與記錄用途。</p>
        <p class="footer-copyright">© 2026 William Chan Archive</p>
      </div>
    </footer>
  </body>

<script>
  const navigation = document.querySelector<HTMLElement>("[data-anchor-years]");
  const select = document.querySelector<HTMLSelectElement>("#timeline-year");
  select?.addEventListener("change", () => window.location.assign(select.value));
  const monthSelect = document.querySelector<HTMLSelectElement>("#timeline-month");
  monthSelect?.addEventListener("change", () => {
    if (monthSelect.value) window.location.assign(monthSelect.value);
  });
  if (navigation) {
    const anchorYears: Record<string, string> = JSON.parse(navigation.dataset.anchorYears ?? "{}");
    const followEvent = () => {
      let id: string;
      try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
      if (!id || !Object.hasOwn(anchorYears, id)) return;
      const year = anchorYears[id];
      const target = document.getElementById(id);
      if (target) target.scrollIntoView();
      else window.location.replace(`/timeline/${year}/${window.location.search}#${encodeURIComponent(id)}`);
    };
    followEvent();
    window.addEventListener("hashchange", followEvent);
  }
</script>

<style>
  .footer-nav .footer-feedback {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .footer-nav .footer-feedback:hover,
  .footer-nav .footer-feedback:focus-visible {
    text-decoration: underline;
  }

  :global(body) {
    margin: 0;
    background: #f7f5f2;
    color: #222;
    font-family: Arial, sans-serif;
  }

  main {
    width: 88%;
    max-width: 960px;
    margin: 0 auto;
    padding: 50px 0 80px;
  }

  .back {
    display: inline-block;
    margin-bottom: 30px;
    color: #77706b;
    text-decoration: none;
  }

  header {
    margin-bottom: 35px;
  }

  header h1 {
    font-size: 36px;
    margin-bottom: 10px;
  }

  article {
    background: white;
    border: 1px solid #e5e1dc;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 20px;
  }

  article h4 {
    margin: 10px 0;
    font-size: 22px;
  }

  article p {
    color: #77706b;
    line-height: 1.7;
  }

  .event-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .year-navigation { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .date-control { display: flex; align-items: center; gap: 12px; max-width: 100%; min-width: 0; }
  .date-control label { white-space: nowrap; }
  .date-control select { min-width: 0; }
  .year-navigation select { max-width: 100%; min-height: 44px; padding: 10px 36px 10px 12px; border: 1px solid #cfc6bf; border-radius: 8px; background: white; color: #222; font: inherit; }
  #year-summary { margin: 28px 0; }
  #year-summary span { display: inline-block; font-size: 15px; font-weight: normal; color: #77706b; }
  .month-group { margin-top: 32px; }
  .month-title { font-size: 20px; color: #675f5a; }
  .year-link { display: inline-block; margin: 4px 12px 4px 0; color: #746c66; }
  .date-navigation { margin-bottom: 24px; color: #746c66; }
  .date-navigation summary { cursor: pointer; }
  .pagination { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 32px; }
  .pagination a, .pagination span { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; margin: 0; }
  .pagination [aria-current="page"] { font-weight: bold; }
  .pagination [aria-disabled="true"] { color: #aaa19a; }
  article { overflow-wrap: anywhere; scroll-margin-top: 20px; }
  article:target { border-color: #746c66; }
  .event-link:hover { text-decoration: underline; }
  .timeline-image { margin: 20px 0; }
  .timeline-image img { display: block; width: 100%; max-width: 480px; height: auto; border-radius: 8px; }
  .timeline-image figcaption { margin-top: 8px; color: #77706b; font-size: 14px; line-height: 1.7; }
  select:focus-visible, a:focus-visible { outline: 2px solid #746c66; outline-offset: 3px; }

  .detail-link {
    display: inline-block;
    color: #746c66;
    font-size: 14px;
    text-decoration-color: #aaa19a;
    text-underline-offset: 3px;
  }

  .site-footer {
    margin-top: 24px;
    padding: 32px 8%;
    background: #675f5a;
    border-top: 4px solid #d8d0ca;
    color: #e3ddd8;
  }

  .footer-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .site-footer p {
    margin: 6px 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .site-footer .footer-title {
    margin-top: 0;
    color: #f5f1ee;
    font-weight: 600;
  }

  .footer-nav {
    overflow-wrap: anywhere;
  }

  .footer-copyright {
    margin-bottom: 0;
    color: #c6bdb7;
  }

  @media (max-width: 700px) {
    main {
      width: 88%;
      padding-top: 30px;
    }

    header h1 {
      font-size: 30px;
    }

    article {
      padding: 20px;
    }

    .site-footer {
      margin-top: 10px;
      padding: 22px 6%;
    }

    .site-footer p {
      margin: 4px 0;
      font-size: 13px;
      line-height: 1.45;
    }
  }
</style>


</html>
