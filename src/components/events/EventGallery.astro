---
import EventSection from "./EventSection.astro";
import GalleryCarousel from "./GalleryCarousel.astro";

interface GalleryItem {
  title: string;
  image: string;
  source: string;
  sourceUrl: string;
  alt?: string;
  ariaLabel?: string;
  hideTitle?: boolean;
  sourcePrefix?: string;
  sourceSuffix?: string;
  hideCaption?: boolean;
}

interface Props {
  items: GalleryItem[];
  title?: string;
  englishLabel?: string;
  contained?: boolean;
}

const { items, title = "照片集", englishLabel = "Gallery", contained = false } = Astro.props;
---

{items.length > 0 && (
  <EventSection id="gallery-heading" title={title} englishLabel={englishLabel}>
    <GalleryCarousel items={items} contained={contained} />
  </EventSection>
)}
