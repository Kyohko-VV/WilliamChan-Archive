---
import EventSection from "./EventSection.astro";
import GalleryCarousel from "./GalleryCarousel.astro";

interface GalleryItem {
  title: string;
  image: string;
  source: string;
  sourceUrl: string;
  alt?: string;
}

interface Props {
  items: GalleryItem[];
  contained?: boolean;
}

const { items, contained = false } = Astro.props;
---

{items.length > 0 && (
  <EventSection id="gallery-heading" title="照片集" englishLabel="Gallery">
    <GalleryCarousel items={items} contained={contained} />
  </EventSection>
)}
