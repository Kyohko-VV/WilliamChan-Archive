---
export interface GalleryCarouselItem {
  title: string;
  image: string;
  source?: string;
  sourceUrl?: string;
  alt?: string;
  ariaLabel?: string;
  hideTitle?: boolean;
  hideCaption?: boolean;
  sourcePrefix?: string;
  sourceSuffix?: string;
}

interface Props {
  items: GalleryCarouselItem[];
  contained?: boolean;
}

const { items, contained = false } = Astro.props;
---

<div class:list={["gallery-carousel", { "is-contained": contained }]} data-gallery-carousel>
  <div class="gallery-grid">
    {items.map((item, index) => (
      <figure class:list={["gallery-item", { "is-active": index === 0 }]}>
        <a
          class="gallery-image-link"
          href={item.image}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.ariaLabel ?? `開啟${item.source ?? item.title}原圖`}
        >
          <img src={item.image} alt={item.alt ?? item.title} loading="lazy" />
        </a>
        {!item.hideCaption && (
          <figcaption>
            {!item.hideTitle && <p>{item.title}</p>}
            {item.source && item.sourceUrl && (
              <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                {item.sourcePrefix ?? "來源："}{item.source}{item.sourceSuffix}
              </a>
            )}
          </figcaption>
        )}
      </figure>
    ))}
  </div>

  {items.length > 1 && (
    <div class="gallery-controls" aria-label="照片切換控制">
      <button type="button" data-gallery-previous>← 上一張</button>
      <p class="gallery-counter" aria-live="polite">
        <span data-gallery-current>1</span> / {items.length}
      </p>
      <button type="button" data-gallery-next>下一張 →</button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery-carousel]").forEach((carousel) => {
    const items = Array.from(carousel.querySelectorAll<HTMLElement>(".gallery-item"));
    const previousButton = carousel.querySelector<HTMLButtonElement>("[data-gallery-previous]");
    const nextButton = carousel.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const currentLabel = carousel.querySelector<HTMLElement>("[data-gallery-current]");
    const desktopGallery = window.matchMedia("(min-width: 701px)");
    let currentIndex = 0;

    const showItem = (index: number) => {
      currentIndex = (index + items.length) % items.length;
      items.forEach((item, itemIndex) => {
        const isCurrent = itemIndex === currentIndex;
        item.classList.toggle("is-active", isCurrent);
        item.hidden = desktopGallery.matches && !isCurrent;
      });

      if (currentLabel) currentLabel.textContent = String(currentIndex + 1);
    };

    previousButton?.addEventListener("click", () => showItem(currentIndex - 1));
    nextButton?.addEventListener("click", () => showItem(currentIndex + 1));
    desktopGallery.addEventListener("change", () => showItem(currentIndex));
    showItem(0);
  });
</script>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .gallery-item {
    margin: 0;
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .gallery-carousel.is-contained .gallery-item img {
    width: auto;
    max-width: 520px;
    max-height: 620px;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
  }

  .gallery-image-link {
    display: block;
  }

  .gallery-controls {
    display: none;
  }

  .gallery-item figcaption {
    margin-top: 10px;
    color: #5f5955;
    line-height: 1.6;
  }

  .gallery-item figcaption p {
    margin: 0;
  }

  .gallery-item a {
    color: #675f5a;
  }

  @media (min-width: 701px) {
    .gallery-grid {
      display: block;
    }

    .gallery-item {
      display: none;
    }

    .gallery-item.is-active {
      display: block;
    }

    .gallery-image-link {
      background: #f8f6f3;
      border-radius: 8px;
    }

    .gallery-item img {
      height: min(65vh, 640px);
      object-fit: contain;
      object-position: center;
    }

    .gallery-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 20px;
    }

    .gallery-controls button {
      padding: 9px 14px;
      background: #ffffff;
      border: 1px solid #d8d0ca;
      border-radius: 8px;
      color: #675f5a;
      font: inherit;
      cursor: pointer;
    }

    .gallery-controls button:hover,
    .gallery-controls button:focus-visible {
      border-color: #a99f98;
    }

    .gallery-counter {
      margin: 0;
      color: #77706b;
      font-variant-numeric: tabular-nums;
    }
  }

  @media (max-width: 700px) {
    .gallery-carousel.is-contained .gallery-item img {
      max-width: 100%;
    }
  }
</style>
