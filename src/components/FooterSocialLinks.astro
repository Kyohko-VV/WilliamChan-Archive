---
const socialLinks = [
  { name: "YouTube", href: "https://youtube.com/williamchanfanpage", icon: "youtube" },
  { name: "Instagram", href: "https://www.instagram.com/kyohkof", icon: "instagram" },
  { name: "X", href: "https://x.com/kyohko_", icon: "x" },
  { name: "Facebook", href: "https://www.facebook.com/williamchanfanpage", icon: "facebook" },
  { name: "微博", href: "https://weibo.com/u/5991922169", icon: "weibo" },
] as const;
---

<nav class="footer-social-links" aria-label="網站管理者的社群連結">
  {socialLinks.map(({ name, href, icon }) => (
    <a href={href} target="_blank" rel="noopener noreferrer" aria-label={name}>
      {icon === "youtube" && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" />
        </svg>
      )}
      {icon === "instagram" && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.5" cy="6.5" r="1" class="filled" />
        </svg>
      )}
      {icon === "x" && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 3h4.7l4.4 5.9L18.2 3H20l-6.1 7.1L20.5 21h-4.7l-4.9-6.5L5.3 21H3.5l6.6-7.7L4 3Zm3.8 1.5H6.9l9.7 15h.9l-9.7-15Z" />
        </svg>
      )}
      {icon === "facebook" && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M13.8 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5H17V3.9c-.7-.1-1.5-.2-2.3-.2-2.3 0-3.9 1.4-3.9 4V10H8.2v3h2.6v8h3Z" />
        </svg>
      )}
      {icon === "weibo" && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9.2 19.7c-3.9 0-7-2-7-4.6 0-1.4.9-3 2.5-4.5 2.2-2.1 4.8-3 5.8-2 .5.5.3 1.5-.2 2.6-.2.5.4.3.8.2 2.1-.9 4-.6 4.8.7 1.2 2-.6 4.5-4 5.4-.7.2-1.3.3-1.9.3Zm-1-6.9c-1.9.2-3.4 1.4-3.2 2.8.1 1.4 1.9 2.3 3.8 2.1 2-.2 3.4-1.5 3.2-2.8-.2-1.4-1.9-2.3-3.8-2.1Zm-.9 3.7c-.7.1-1.3-.3-1.4-.8-.1-.6.4-1.1 1.1-1.2.7-.1 1.3.3 1.4.8.1.6-.4 1.1-1.1 1.2Z" />
          <path d="M14.5 7.8a4 4 0 0 1 4.6 3.1M14.9 4.8a7 7 0 0 1 7.9 5.4" class="stroked" />
        </svg>
      )}
    </a>
  ))}
</nav>

<style>
  .footer-social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 9px 0 11px;
  }

  a {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(245, 241, 238, 0.18);
    border-radius: 50%;
    color: #d8d0ca;
    transition: color 160ms ease, border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  rect,
  circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .filled {
    fill: currentColor;
    stroke: none;
  }

  .stroked {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.7;
  }

  a:hover,
  a:focus-visible {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.42);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }

  a:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.7);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    a { transition: none; }
  }
</style>
