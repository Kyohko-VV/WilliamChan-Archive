---
import EventGallery from "../events/EventGallery.astro";
import EventSection from "../events/EventSection.astro";
import type { Work } from "../../data/works";
import { works } from "../../data/works";
import { events } from "../../data/events";
import WorkLayout from "../../layouts/WorkLayout.astro";
import YouTubeEmbed from "./YouTubeEmbed.astro";

interface Props { work: Work; }
const { work } = Astro.props;
// Same public cover, resized for sharing; retain the original Work/Gallery asset.
const shareImage = work.id === "na-pa-wo-men-2026"
  ? new URL("/share/na-pa-wo-men-cover.jpg", Astro.site).href
  : work.cover?.src;
// Display only: retain the original date text, timestamps, and source order in data.
const displaySourceText = (text: string | undefined) => work.id === "music-hu-hang"
  ? text?.replace(/(\d{4}-\d{2}-\d{2})[ \t]+\d{2}:\d{2}\b/g, "$1")
  : text;
// relatedHref is the explicit stable Work route; never infer links from titles.
const relatedTimeline = events
  .filter((event) => Boolean(work.href) && event.relatedHref === work.href)
  .sort((a, b) => a.date.localeCompare(b.date));

const gallery = work.cover ? [
  {
    title: "單曲封面",
    image: work.cover.src,
    alt: work.cover.alt,
    source: work.images?.[0]?.source ?? work.officialSources?.[0]?.displayName ?? "作品官方來源",
    sourceUrl: work.images?.[0]?.sourceUrl ?? work.officialSources?.[0]?.url ?? work.cover.src,
  },
  ...(work.images ?? []).filter((image) => image.src !== work.cover?.src).map((image, index) => ({ title: `作品圖片 ${index + 1}`, image: image.src, alt: image.alt, source: image.source, sourceUrl: image.sourceUrl })),
] : [];
const relatedStages = work.relatedStages
  ?.map((stageHref) => works.find((entry) => entry.href === stageHref))
  .filter((stage) => stage !== undefined);
const displayDate = work.releaseDate ?? work.date.replaceAll(".", "-");
const [year, month, day] = displayDate.split("-");
---

<WorkLayout
  pageTitle={`${work.title}｜陳偉霆資料庫`}
  description={work.seoDescription ?? work.description ?? `陳偉霆單曲${work.title}作品資料。`}
  date={`${year}年${Number(month)}月${Number(day)}日`}
  dateTime={displayDate}
  title={work.title}
  category={`${work.category} / ${work.type}`}
  artist={work.artist}
  ogImage={shareImage}
>
  <EventSection id="summary-heading" title="作品簡介">{(work.introduction ?? [work.description]).map((paragraph) => <p class="summary">{paragraph}</p>)}</EventSection>

  <EventSection id="details-heading" title="作品資料">
    <dl>
      <div><dt>類型</dt><dd>{work.category} / {work.type}</dd></div>
      <div><dt>歌手</dt><dd>{work.artist}</dd></div>
      <div><dt>發行日期</dt><dd><time datetime={displayDate}>{displayDate}</time></dd></div>
      {work.mvReleaseDate && <div><dt>MV 公開日</dt><dd><time datetime={work.mvReleaseDate}>{work.mvReleaseDate}</time></dd></div>}
      {work.status && <div><dt>狀態</dt><dd>{work.status}</dd></div>}
      {work.credits?.map((credit) => <div><dt>{credit.label}</dt><dd>{credit.value}</dd></div>)}
    </dl>
  </EventSection>

  <EventSection id="official-links-heading" title="官方收聽 / 觀看">
    {work.streamingLinks && <div class="link-group"><h3>官方收聽</h3><ul class="video-list">{work.streamingLinks.map((link) => <li>{link.url ? <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a> : link.label}</li>)}</ul></div>}
    {work.watchLinks && <div class="link-group"><h3>Official MV</h3><ul class="video-list">{work.watchLinks.map((link) => <li>{link.url ? <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a> : link.label}</li>)}</ul></div>}
  </EventSection>

  {work.mvBand?.length && <EventSection id="mv-band-heading" title="MV 樂隊設定"><dl>{work.mvBand.map((member) => <div><dt>{member.label}</dt><dd>{member.value}</dd></div>)}</dl></EventSection>}

  {work.promotion?.length && <EventSection id="promotion-heading" title="官方宣傳記錄 / Promotion"><ul class="video-list">{work.promotion.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{displaySourceText(source.displayName)}</a><p>{displaySourceText(source.note)}</p></li>)}</ul></EventSection>}

  {(work.notes?.length ?? 0) > 0 && <EventSection id="notes-heading" title="歌曲理念 / Notes">{work.notes?.map((note) => <p class="summary note-item">{note}</p>)}</EventSection>}

  {((work.relatedPerformances?.length ?? 0) > 0 || (relatedStages?.length ?? 0) > 0) && (
    <EventSection id="related-stages-heading" title="相關舞台"><ul class="video-list">
      {work.relatedPerformances?.map((stage) => <li>{stage.videoUrl ? <a href={stage.videoUrl} target="_blank" rel="noopener noreferrer">{stage.date && `${stage.date}｜`}{stage.title}</a> : <span>{stage.date && `${stage.date}｜`}{stage.title}</span>}<p>演唱歌曲：{stage.song}{stage.source && ` · 來源：${stage.source}`}</p></li>)}
      {relatedStages?.map((stage) => <li><a href={stage.href}>{stage.title}</a><p>演唱歌曲：{work.title}</p></li>)}
    </ul></EventSection>
  )}

  {(work.archiveVideos?.length ?? 0) > 0 && (
    <EventSection id="archive-videos-heading" title="Archive Video">
      <div class="archive-video-list">
        {work.archiveVideos?.map((video) => (
          <article class="archive-video">
            <h3>{video.label}</h3>
            <YouTubeEmbed url={video.url} title={video.label} />
            <p>{video.source} · {video.type}</p>
          </article>
        ))}
      </div>
    </EventSection>
  )}

  {(work.visualHighlights?.length ?? 0) > 0 && (
    <EventSection id="visual-highlights-heading" title="MV 造型 / Visual 延伸內容">
      <ul class="video-list">
        {work.visualHighlights?.map((highlight) => (
          <li>
            <a href={highlight.sourceUrl} target="_blank" rel="noopener noreferrer">{highlight.title}</a>
            <p>{highlight.description}</p>
          </li>
        ))}
      </ul>
    </EventSection>
  )}

  {gallery.length > 0 && <EventGallery items={gallery} />}

  {(work.officialSources?.length ?? 0) > 0 && <EventSection id="sources-heading" title="官方來源"><ul class="video-list">{work.officialSources?.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{displaySourceText(source.displayName)}</a>{source.note && <p>{displaySourceText(source.note)}</p>}</li>)}</ul></EventSection>}

  {relatedTimeline.length > 0 && (
    <EventSection id="related-timeline-heading" title="Related Timeline / 相關時間線">
      <ul class="video-list">
        {relatedTimeline.map((event) => (
          <li><a href={event.id || event.anchor ? `/timeline#${event.id ?? event.anchor}` : "/timeline"}><time datetime={event.date}>{event.date}</time>｜{event.title}</a></li>
        ))}
      </ul>
    </EventSection>
  )}
</WorkLayout>

<style>
  .link-group + .link-group { margin-top: 24px; }
  .link-group h3 { margin: 0 0 12px; font-size: 17px; }
  .note-item + .note-item { margin-top: 16px; }
  .archive-video-list { display: grid; gap: 28px; }
  .archive-video h3 { margin: 0 0 12px; font-size: 17px; }
  .archive-video p { margin: 10px 0 0; color: #77706b; font-size: 14px; }
</style>
