---
import { events } from "../data/events";
import FooterSocialLinks from "../components/FooterSocialLinks.astro";

const sortedEvents = [...events].sort((a, b) =>
  b.date.localeCompare(a.date)
);
const eventsByYear = Object.groupBy(
  sortedEvents,
  (event) => event.date.slice(0, 4)
);
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>時間線 | 陳偉霆資料庫</title>
  </head>

<body>
  <main>
    <a href="/" class="back">← 返回首頁</a>

    <header>
      <h1>時間線</h1>
      <p>William Chan Archive · Timeline</p>
    </header>

{Object.entries(eventsByYear)
  .sort(([yearA], [yearB]) => yearB.localeCompare(yearA))
  .map(([year, yearEvents]) => (
    <section class="year-group">
      <h2 class="year-title">{year}</h2>

      {yearEvents?.map((event) => {
        const content = (
          <article id={event.anchor}>
            <strong>{event.date.slice(5).replace("-", ".")}</strong>
            <h3>{event.title}</h3>
            <p>{event.description}</p>
            {event.href && <span class="detail-link">查看事件詳情 →</span>}
            {event.relatedHref && (
              <a class="detail-link" href={event.relatedHref}>{event.relatedLabel}</a>
            )}
          </article>
        );

        return event.href ? (
          <a class="event-link" href={event.href}>{content}</a>
        ) : content;
      })}
    </section>
  ))}
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">陳偉霆資料庫 · William Chan Archive</p>
        <FooterSocialLinks />
        <p class="footer-nav">Timeline ｜ Works ｜ People &amp; Characters ｜ Sources</p>
        <p>非官方粉絲資料庫</p>
        <p>本站內容僅作資料整理與記錄用途。</p>
        <p class="footer-copyright">© 2026 William Chan Archive</p>
      </div>
    </footer>
  </body>

<style>
  :global(body) {
    margin: 0;
    background: #f7f5f2;
    color: #222;
    font-family: Arial, sans-serif;
  }

  main {
    width: 88%;
    max-width: 960px;
    margin: 0 auto;
    padding: 50px 0 80px;
  }

  .back {
    display: inline-block;
    margin-bottom: 30px;
    color: #77706b;
    text-decoration: none;
  }

  header {
    margin-bottom: 35px;
  }

  header h1 {
    font-size: 36px;
    margin-bottom: 10px;
  }

  article {
    background: white;
    border: 1px solid #e5e1dc;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 20px;
  }

  article h2 {
    margin: 10px 0;
    font-size: 22px;
  }

  article p {
    color: #77706b;
    line-height: 1.7;
  }

  .event-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .event-link article {
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .event-link:hover article {
    border-color: #cfc6bf;
    transform: translateY(-2px);
  }

  .detail-link {
    display: inline-block;
    color: #746c66;
    font-size: 14px;
    text-decoration-color: #aaa19a;
    text-underline-offset: 3px;
  }

  .site-footer {
    margin-top: 24px;
    padding: 32px 8%;
    background: #675f5a;
    border-top: 4px solid #d8d0ca;
    color: #e3ddd8;
  }

  .footer-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .site-footer p {
    margin: 6px 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .site-footer .footer-title {
    margin-top: 0;
    color: #f5f1ee;
    font-weight: 600;
  }

  .footer-nav {
    overflow-wrap: anywhere;
  }

  .footer-copyright {
    margin-bottom: 0;
    color: #c6bdb7;
  }

  @media (max-width: 700px) {
    main {
      width: 88%;
      padding-top: 30px;
    }

    header h1 {
      font-size: 30px;
    }

    article {
      padding: 20px;
    }

    .site-footer {
      margin-top: 10px;
      padding: 22px 6%;
    }

    .site-footer p {
      margin: 4px 0;
      font-size: 13px;
      line-height: 1.45;
    }
  }
</style>


</html>
