---
import { works } from "../data/works";
import FooterSocialLinks from "../components/FooterSocialLinks.astro";
import SeoHead from "../components/SeoHead.astro";

const sortedWorks = [...works].sort((a, b) => b.date.localeCompare(a.date));
const screenWorks = sortedWorks.filter((work) => work.category === "影視");
const musicWorks = sortedWorks.filter((work) => work.category === "音樂");
const stageWorks = sortedWorks.filter((work) => work.category === "舞台・活動");
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>作品分類 | 陳偉霆資料庫</title>
    <meta
      name="description"
      content="陳偉霆作品分類，收錄影視、音樂及舞台與活動相關資料。"
    />
    <SeoHead
      title="作品分類 | 陳偉霆資料庫"
      description="陳偉霆作品分類，收錄影視、音樂及舞台與活動相關資料。"
    />
  </head>

  <body>
    <main>
      <a href="/" class="back">← 返回首頁</a>

      <header>
        <h1>作品分類</h1>
        <p>William Chan Archive · Works</p>
      </header>

      <div class="category-grid">
        <section aria-labelledby="screen-heading">
          <h2 id="screen-heading">影視</h2>
          {screenWorks.length > 0 ? screenWorks.map((work) => (
            <a class="work-link" href={work.href}>
              <article>
                <p class="work-date"><time datetime={work.date.replaceAll(".", "-")}>{work.date}</time></p>
                <h3>{work.title}</h3>
                {work.href === "/events/2026-our-dormitory-party" && (
                  <p class="work-type">綜藝／節目</p>
                )}
                <p class="work-location">{work.location}</p>
                <p class="detail-link">查看活動詳情 →</p>
              </article>
            </a>
          )) : <p class="empty-state">內容整理中。</p>}
        </section>

        <section aria-labelledby="music-heading">
          <h2 id="music-heading">音樂</h2>
          {musicWorks.length > 0 ? musicWorks.map((work) => (
            <a class="work-link" href={work.href}>
              <article>
                <p class="work-date"><time datetime={work.date.replaceAll(".", "-")}>{work.date}</time></p>
                <h3>{work.title}</h3>
                <p class="work-location">{work.location}</p>
                <p class="detail-link">查看活動詳情 →</p>
              </article>
            </a>
          )) : <p class="empty-state">內容整理中。</p>}
        </section>

        <section aria-labelledby="stage-heading">
          <h2 id="stage-heading">舞台・活動</h2>
          {stageWorks.length > 0 ? stageWorks.map((work) => (
            <a class="work-link" href={work.href}>
              <article>
                <p class="work-date"><time datetime={work.date.replaceAll(".", "-")}>{work.date}</time></p>
                <h3>{work.title}</h3>
                <p class="work-location">{work.location}</p>
                <p class="detail-link">查看活動詳情 →</p>
              </article>
            </a>
          )) : <p class="empty-state">內容整理中。</p>}
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">陳偉霆資料庫 · William Chan Archive</p>
        <FooterSocialLinks />
        <p class="footer-nav">Timeline ｜ Works ｜ People &amp; Characters ｜ Sources</p>
        <p>非官方粉絲資料庫</p>
        <p>本站內容僅作資料整理與記錄用途。</p>
        <p class="footer-copyright">© 2026 William Chan Archive</p>
      </div>
    </footer>
  </body>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(body) {
      margin: 0;
      background: #f8f6f3;
      color: #292624;
      font-family: "Noto Sans TC", "Noto Sans JP", Arial, sans-serif;
    }

    main {
      width: 88%;
      max-width: 960px;
      margin: 0 auto;
      padding: 50px 0 80px;
    }

    .back {
      display: inline-block;
      margin-bottom: 30px;
      color: #77706b;
      text-decoration: none;
    }

    header {
      margin-bottom: 35px;
    }

    h1 {
      margin: 0 0 10px;
      font-size: 36px;
      letter-spacing: 0.5px;
    }

    header p {
      margin: 0;
      color: #77706b;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    section {
      padding: 28px;
      background: #ffffff;
      border: 1px solid #e5e1dc;
      border-radius: 12px;
    }

    section:last-child {
      grid-column: 1 / -1;
    }

    h2 {
      margin: 0 0 20px;
      font-size: 22px;
    }

    .empty-state {
      margin: 0;
      color: #958d87;
    }

    .work-link {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    article {
      padding: 22px;
      border: 1px solid #ebe6e2;
      border-radius: 10px;
      transition: border-color 160ms ease, transform 160ms ease;
    }

    .work-link:hover article,
    .work-link:focus-visible article {
      border-color: #cfc6bf;
      transform: translateY(-2px);
    }

    article h3 {
      margin: 5px 0 10px;
      font-size: 20px;
    }

    article p {
      margin: 0;
      color: #77706b;
    }

    .work-date {
      font-size: 14px;
    }

    .work-location {
      line-height: 1.6;
    }

    .work-type {
      margin-bottom: 3px;
      color: #5f5955;
      font-size: 14px;
      line-height: 1.6;
    }

    article .detail-link {
      margin-top: 14px;
      color: #675f5a;
      font-size: 14px;
    }

    .site-footer {
      margin-top: 24px;
      padding: 32px 8%;
      background: #675f5a;
      border-top: 4px solid #d8d0ca;
      color: #e3ddd8;
    }

    .footer-inner {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
    }

    .site-footer p {
      margin: 6px 0;
      font-size: 14px;
      line-height: 1.55;
    }

    .site-footer .footer-title {
      margin-top: 0;
      color: #f5f1ee;
      font-weight: 600;
    }

    .footer-nav {
      overflow-wrap: anywhere;
    }

    .footer-copyright {
      margin-bottom: 0;
      color: #c6bdb7;
    }

    @media (max-width: 700px) {
      main {
        width: 88%;
        padding: 30px 0 50px;
      }

      .back {
        margin-bottom: 24px;
      }

      header {
        margin-bottom: 28px;
      }

      h1 {
        font-size: 30px;
      }

      .category-grid {
        grid-template-columns: 1fr;
      }

      section,
      article {
        padding: 20px;
      }

      section:last-child {
        grid-column: auto;
      }

      .site-footer {
        margin-top: 10px;
        padding: 22px 6%;
      }

      .site-footer p {
        margin: 4px 0;
        font-size: 13px;
        line-height: 1.45;
      }
    }
  </style>
</html>
