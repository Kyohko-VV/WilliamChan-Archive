---
import { events } from "../data/events";
import { fanActivities } from "../data/fanActivities";
import { peopleCharacters } from "../data/peopleCharacters";
import { sourceCategories, sources } from "../data/sources";
import { works } from "../data/works";
import { brandEditorialEntries } from "../data/brandEditorial";
import FooterSocialLinks from "../components/FooterSocialLinks.astro";
import SeoHead from "../components/SeoHead.astro";

const latestEvents = [...events]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const latestFanActivities = [...fanActivities]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const latestWorks = [...works]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const latestBrandEditorialEntries = [...brandEditorialEntries]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const sourceCounts = sourceCategories.map((category) => ({
  category,
  count: sources.filter((source) => source.category === category).length,
}));

const characterCount = peopleCharacters.filter((entry) => entry.type === "character").length;
---

<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>陳偉霆資料庫｜William Chan Archive</title>
   <meta
  name="description"
  content="陳偉霆（William Chan），中國香港出身的男歌手、演員，1985年11月21日出生。本網站整理陳偉霆的影視作品、音樂作品、角色、演藝活動、時間線、粉絲活動、日本粉絲小組及相關可靠來源。"
/>
    <SeoHead
      title="陳偉霆資料庫｜William Chan Archive"
      description="陳偉霆（William Chan），中國香港出身的男歌手、演員，1985年11月21日出生。本網站整理陳偉霆的影視作品、音樂作品、角色、演藝活動、時間線、粉絲活動、日本粉絲小組及相關可靠來源。"
    />
  </head>

  <body>
    <header>
      <h1>陳偉霆資料庫</h1>
<p>William Chan Archive｜陳偉霆｜ウィリアム・チャン</p>
<p class="site-intro">
  陳偉霆（William Chan），中國香港出身的歌手、演員。本站整理其影視、音樂、角色、演藝活動、時間線與可靠來源，並記錄相關粉絲活動。
</p>
    </header>

    <main>



<section>
<h2>Today</h2>
<div class="today-group">
  <h3 class="today-section-title">今日資訊</h3>
  <div id="today-current-events"></div>
</div>
<div class="today-group">
  <h3 class="today-section-title" id="today-label">歷史上的今天</h3>
  <div id="today-events"></div>
</div>
</section>

<a href="/timeline" class="card-link">
  <section>
    <h2>Timeline</h2>

    <div class="latest-events">
      {latestEvents.map((event) => (
        <p>
          <strong>{event.date.slice(5).replace("-", ".")}</strong>
          {"　"}
          {event.title}
        </p>
      ))}
    </div>

    <p>查看完整時間線 →</p>
  </section>
</a>
      <section class="works-card">
        <h2>Works</h2>
        <p class="works-subtitle">影視・音樂・舞台</p>

        <div class="latest-works">
          {latestWorks.map((work) => (
            <div class="work-preview">
              <p>
                <strong>{work.date}</strong>
                {"　"}
                <a href={work.href}>{work.title}</a>
              </p>
              <p class="work-category">
                {work.href === "/events/2026-our-dormitory-party" ? "綜藝／節目" : work.category}
              </p>
            </div>
          ))}
        </div>

        <p><a class="all-works-link" href="/works">查看全部作品 →</a></p>
      </section>

      <section class="brand-editorial-preview">
        <h2>Brand / Editorial</h2>
        <p class="brand-editorial-subtitle">品牌合作・廣告・雜誌</p>

        <div class="latest-brand-editorial">
          {latestBrandEditorialEntries.map((entry) => (
            <p>
              <strong>{entry.date}</strong>
              {"　"}
              <a href={entry.href ?? "/brand-editorial"}>{entry.brand}｜{entry.title}</a>
            </p>
          ))}
        </div>

        <p><a class="all-works-link" href="/brand-editorial">查看全部 →</a></p>
      </section>

      <a href="/people-characters" class="card-link">
        <section>
          <h2>People & Characters</h2>
          <p>人物與角色</p>
          <p class="character-summary">角色 {characterCount}</p>
          <p>查看人物與角色 →</p>
        </section>
      </a>

      <a href="/sources" class="card-link">
        <section>
          <h2>Sources</h2>
          <p>官方與可靠來源</p>
          <p class="source-summary">
            {sourceCounts.map(({ category, count }, index) => (
              <span>{index > 0 && <span class="source-divider">｜</span>}{category} {count}</span>
            ))}
          </p>
          <p>查看來源 →</p>
        </section>
      </a>

      <a href="/fan-activities" class="card-link">
        <section>
          <h2>ウィリアム・チャン推し活 IN OSAKA（仮）</h2>
          <div class="latest-fan-activities">
            {latestFanActivities.map((activity) => (
              <p>
                <strong>{activity.date}</strong>
                {"　"}
                {activity.title}
              </p>
            ))}
          </div>
          <p>查看完整活動記錄 →</p>
        </section>
      </a>
      <a href="/media/" class="card-link">
        <section>
          <h2>Media Archive / 影像資料</h2>
          <p>瀏覽網站已公開的照片與影片資料。</p>
          <p>查看影像資料 →</p>
        </section>
      </a>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">陳偉霆資料庫 · William Chan Archive</p>
        <FooterSocialLinks />
        <p class="footer-nav">Timeline ｜ Works ｜ People &amp; Characters ｜ <a href="/sources">Sources</a></p>
        <p>非官方粉絲資料庫</p>
        <p>本站內容僅作資料整理與記錄用途。</p>
        <p class="footer-copyright">© 2026 William Chan Archive</p>
      </div>
    </footer>
  </body>
</html>
<script>
  import { events } from "../data/events";
  import { getTaiyoToHoshiBroadcast } from "../utils/taiyoToHoshiBroadcast.js";
  import { getWatashiNoKanpekiNaKekkonBroadcast } from "../utils/watashiNoKanpekiNaKekkonBroadcast.js";

  const now = new Date();

  const japaneseDateParts = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).formatToParts(now);
  const year = japaneseDateParts.find(({ type }) => type === "year")?.value ?? "";
  const month = japaneseDateParts.find(({ type }) => type === "month")?.value ?? "";
  const day = japaneseDateParts.find(({ type }) => type === "day")?.value ?? "";
  const today = `${month}-${day}`;
  const currentDate = `${year}-${today}`;

  const label = document.getElementById("today-label");
  const historyContainer = document.getElementById("today-events");
  const currentContainer = document.getElementById("today-current-events");

  if (label) {
    label.textContent = `歷史上的今天 · ${Number(month)}月${Number(day)}日`;
  }

  const currentEvents = events.filter((event) => event.date === currentDate);
  const historicalEvents = events.filter(
    (event) => event.date.slice(5) === today && event.date.slice(0, 4) !== year
  );
  const broadcast = getTaiyoToHoshiBroadcast(now);
  const watashiNoKanpekiNaKekkonBroadcast = getWatashiNoKanpekiNaKekkonBroadcast(now);

  if (currentContainer) {
    const currentEventsHtml = currentEvents.map((event) => `
      <article>
        <strong>${event.date}</strong>
        <h3>${event.title}</h3>
        ${event.description ? `<p>${event.description}</p>` : ""}
        ${event.source && event.sourceUrl ? `<p><a class="today-source-link" href="${event.sourceUrl}" target="_blank" rel="noopener noreferrer">來源：${event.source} →</a></p>` : ""}
      </article>
    `).join("");

    const broadcastHtml = broadcast ? `
      <article class="today-broadcast">
        <strong>日本播出</strong>
        <h3>《太陽と星辰（ほし）－時を越える追跡者－》</h3>
        <p>チャンネル銀河</p>
        <p><strong>${broadcast.episode}</strong></p>
        <p>${broadcast.officialTime}</p>
        <p><a class="all-works-link" href="https://www.ch-ginga.jp/detail/taiyoutohoshi/">查看節目詳情 →</a></p>
      </article>
    ` : "";

    const watashiNoKanpekiNaKekkonBroadcastHtml = watashiNoKanpekiNaKekkonBroadcast ? `
      <article class="today-broadcast">
        <strong>日本播出</strong>
        <h3>《私の完璧な結婚（日本語字幕版）》</h3>
        <p><strong>${watashiNoKanpekiNaKekkonBroadcast.firstEpisode} 深夜2:00 / ${watashiNoKanpekiNaKekkonBroadcast.secondEpisode} 深夜3:00</strong></p>
        <p>ホームドラマチャンネル</p>
      </article>
    ` : "";

    currentContainer.innerHTML = currentEventsHtml + broadcastHtml + watashiNoKanpekiNaKekkonBroadcastHtml || "<p>暫無記錄</p>";
  }

  if (historyContainer) {
    const eventsHtml = historicalEvents.map((event) => `
      <article>
        <strong>${event.date}</strong>
        <h3>${event.title}</h3>
        <p>${event.description}</p>
      </article>
    `).join("");

    historyContainer.innerHTML = eventsHtml || "<p>暫無記錄</p>";
  }
</script>


<style>
  :global(*) {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f8f6f3;
    color: #292624;
    font-family:
      "Noto Sans TC",
      "Noto Sans JP",
      Arial,
      sans-serif;
  }

  header {
    padding: 70px 8% 45px;
    background: #ffffff;
    border-bottom: 1px solid #e7e1dc;
  }

  h1 {
    margin: 0 0 15px;
    font-size: 42px;
    letter-spacing: 1px;
  }

  header p {
    margin: 0;
    color: #77706b;
  }

  main {
    width: 84%;
    max-width: 1100px;
    margin: 50px auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  section {
    background: white;
    padding: 28px;
    border: 1px solid #ebe6e2;
    border-radius: 14px;
  }



  h2 {
    margin-top: 0;
    font-size: 22px;
  }

  section p {
    margin-bottom: 0;
    color: #77706b;
  }

  .today-group {
    padding-top: 18px;
  }

  .today-group + .today-group {
    margin-top: 22px;
    border-top: 1px solid #ebe6e2;
  }

  .today-section-title {
    margin: 0 0 12px;
    color: #4f4945;
    font-size: 16px;
  }

  .today-group article h3 {
    margin: 10px 0;
    font-size: 18px;
    line-height: 1.5;
  }

  .today-group article p {
    margin-top: 6px;
    line-height: 1.6;
  }

  .card-link {
  color: inherit;
  text-decoration: none;
}

.card-link section {
  height: 100%;
}

  .works-subtitle {
    margin-top: 0;
  }

  .brand-editorial-subtitle {
    margin-top: 0;
  }

  .latest-brand-editorial {
    margin-top: 20px;
  }

  .latest-brand-editorial p {
    margin-top: 0;
    line-height: 1.6;
  }

  .latest-brand-editorial a {
    color: inherit;
    text-decoration: none;
  }

  .latest-brand-editorial a:hover,
  .latest-brand-editorial a:focus-visible {
    text-decoration: underline;
  }

  .source-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    font-size: 14px;
  }

  .character-summary {
    font-size: 14px;
  }

  .source-divider {
    margin-right: 8px;
    color: #b0a7a1;
  }

  .latest-works {
    margin-top: 20px;
  }

  .work-preview p {
    margin-top: 0;
    line-height: 1.6;
  }

  .work-preview a,
  .all-works-link,
  :global(.today-source-link),
  :global(.today-broadcast .all-works-link) {
    color: inherit;
    text-decoration: none;
  }

  .work-preview a:hover,
  .work-preview a:focus-visible,
  .all-works-link:hover,
  .all-works-link:focus-visible,
  :global(.today-source-link:hover),
  :global(.today-source-link:focus-visible),
  :global(.today-broadcast .all-works-link:hover),
  :global(.today-broadcast .all-works-link:focus-visible) {
    text-decoration: underline;
  }

  .work-preview .work-category {
    margin-top: 4px;
    color: #958d87;
    font-size: 14px;
  }

  .site-footer {
    margin-top: 24px;
    padding: 32px 8%;
    background: #675f5a;
    border-top: 4px solid #d8d0ca;
    color: #e3ddd8;
  }

  .footer-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .site-footer p {
    margin: 6px 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .site-footer .footer-title {
    margin-top: 0;
    color: #f5f1ee;
    font-weight: 600;
  }

  .footer-nav {
    overflow-wrap: anywhere;
  }

  .footer-nav a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    text-decoration: underline;
  }

  .footer-copyright {
    margin-bottom: 0;
    color: #c6bdb7;
  }

  @media (max-width: 700px) {
    header {
      padding: 24px 6% 18px;
    }

    h1 {
      margin-bottom: 10px;
      font-size: 26px;
    }

    header p {
      font-size: 13px;
      line-height: 1.55;
    }

    header .site-intro {
      margin-top: 4px;
      font-size: 12px;
      line-height: 1.6;
    }

    main {
      width: 88%;
      grid-template-columns: 1fr;
    }

    .site-footer {
      margin-top: 10px;
      padding: 22px 6%;
    }

    .site-footer p {
      margin: 4px 0;
      font-size: 13px;
      line-height: 1.45;
    }

    
  }
</style>
