---
import { events } from "../data/events";
import { fanActivities } from "../data/fanActivities";

const latestEvents = [...events]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const latestFanActivities = [...fanActivities]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);
---

<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>陳偉霆資料庫｜William Chan Archive</title>
   <meta
  name="description"
  content="陳偉霆（William Chan），中國香港出身的男歌手、演員，1985年11月21日出生。本網站整理陳偉霆的影視作品、音樂作品、角色、演藝活動、時間線、粉絲活動、日本粉絲小組及相關可靠來源。"
/>
  </head>

  <body>
    <header>
      <h1>陳偉霆資料庫</h1>
<p>William Chan Archive｜陳偉霆｜ウィリアム・チャン</p>
<p class="site-intro">
  陳偉霆（William Chan），中國香港出身的歌手、演員。本站整理其影視、音樂、角色、演藝活動、時間線與可靠來源，並記錄相關粉絲活動。
</p>
    </header>

    <main>



<section>
<h2>Today</h2>
<p id="today-label">歷史上的今天</p>
<div id="today-events"></div>
  
</section>

<a href="/timeline" class="card-link">
  <section>
    <h2>Timeline</h2>

    <div class="latest-events">
      {latestEvents.map((event) => (
        <p>
          <strong>{event.date.slice(5).replace("-", ".")}</strong>
          {"　"}
          {event.title}
        </p>
      ))}
    </div>

    <p>查看完整時間線 →</p>
  </section>
</a>
      <section>
        <h2>Works</h2>
        <p>影視・音樂・舞台</p>
      </section>

      <section>
        <h2>People & Characters</h2>
        <p>人物與角色</p>
      </section>

      <section>
        <h2>Sources</h2>
        <p>官方與可靠來源</p>
      </section>

      <a href="/fan-activities" class="card-link">
        <section>
          <h2>ウィリアム・チャン推し活 IN OSAKA（仮）</h2>
          <div class="latest-fan-activities">
            {latestFanActivities.map((activity) => (
              <p>
                <strong>{activity.date}</strong>
                {"　"}
                {activity.title}
              </p>
            ))}
          </div>
          <p>查看完整活動記錄 →</p>
        </section>
      </a>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">陳偉霆資料庫 · William Chan Archive</p>
        <p class="footer-nav">Timeline ｜ Works ｜ People &amp; Characters ｜ Sources</p>
        <p>非官方粉絲資料庫</p>
        <p>本站內容僅作資料整理與記錄用途。</p>
        <p class="footer-copyright">© 2026 William Chan Archive</p>
      </div>
    </footer>
  </body>
</html>
<script define:vars={{ events }}>
  const now = new Date();

  const month = String(now.getMonth() + 1).padStart(2, "0");
  const day = String(now.getDate()).padStart(2, "0");
  const today = `${month}-${day}`;

  const label = document.getElementById("today-label");
  const container = document.getElementById("today-events");

  if (label) {
    label.textContent = `歷史上的今天 · ${now.getMonth() + 1}月${now.getDate()}日`;
  }

  const todayEvents = events.filter((event) => event.date.slice(5) === today);

  if (container) {
    container.innerHTML = todayEvents.map((event) => `
      <article>
        <strong>${event.date}</strong>
        <h3>${event.title}</h3>
        <p>${event.description}</p>
      </article>
    `).join("");
  }
</script>


<style>
  :global(*) {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f8f6f3;
    color: #292624;
    font-family:
      "Noto Sans TC",
      "Noto Sans JP",
      Arial,
      sans-serif;
  }

  header {
    padding: 70px 8% 45px;
    background: #ffffff;
    border-bottom: 1px solid #e7e1dc;
  }

  h1 {
    margin: 0 0 15px;
    font-size: 42px;
    letter-spacing: 1px;
  }

  header p {
    margin: 0;
    color: #77706b;
  }

  main {
    width: 84%;
    max-width: 1100px;
    margin: 50px auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  section {
    background: white;
    padding: 28px;
    border: 1px solid #ebe6e2;
    border-radius: 14px;
  }



  h2 {
    margin-top: 0;
    font-size: 22px;
  }

  section p {
    margin-bottom: 0;
    color: #77706b;
  }

  .card-link {
  color: inherit;
  text-decoration: none;
}

.card-link section {
  height: 100%;
}

  .site-footer {
    margin-top: 24px;
    padding: 32px 8%;
    background: #675f5a;
    border-top: 4px solid #d8d0ca;
    color: #e3ddd8;
  }

  .footer-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .site-footer p {
    margin: 6px 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .site-footer .footer-title {
    margin-top: 0;
    color: #f5f1ee;
    font-weight: 600;
  }

  .footer-nav {
    overflow-wrap: anywhere;
  }

  .footer-copyright {
    margin-bottom: 0;
    color: #c6bdb7;
  }

  @media (max-width: 700px) {
    header {
      padding: 32px 6% 24px;
    }

    h1 {
      font-size: 28px;
    }

    header p {
      font-size: 14px;
      line-height: 1.45;
    }

    main {
      width: 88%;
      grid-template-columns: 1fr;
    }

    .site-footer {
      margin-top: 10px;
      padding: 22px 6%;
    }

    .site-footer p {
      margin: 4px 0;
      font-size: 13px;
      line-height: 1.45;
    }

    
  }
</style>
