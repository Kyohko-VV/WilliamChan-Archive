---
import { sourceCategories, sources } from "../data/sources";
import FooterSocialLinks from "../components/FooterSocialLinks.astro";
import SeoHead from "../components/SeoHead.astro";

const groupedSources = sourceCategories.map((category) => ({
  category,
  sources: sources.filter((source) => source.category === category),
}));
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <meta
      name="description"
      content="William Chan Archive 使用的官方與可靠資料來源索引。"
    />
    <title>來源索引 | 陳偉霆資料庫</title>
    <SeoHead
      title="來源索引 | 陳偉霆資料庫"
      description="William Chan Archive 使用的官方與可靠資料來源索引。"
    />
  </head>

  <body>
    <main>
      <a href="/" class="back">← 返回首頁</a>
      <p class="site-identity">陳偉霆資料庫 · William Chan Archive</p>

      <header class="page-header">
        <p class="eyebrow">REFERENCE DIRECTORY</p>
        <h1>來源索引</h1>
        <p class="intro">
          集中整理本站引用的官方與可靠來源，方便 Event、Works 與 Timeline
          維持一致。第一版僅收錄少量已知來源，連結將持續核對與補充。
        </p>
      </header>

      <nav class="category-nav" aria-label="來源分類">
        {groupedSources.map(({ category, sources: categorySources }) => (
          <a href={`#${category}`}>{category}<span>{categorySources.length}</span></a>
        ))}
      </nav>

      <div class="source-groups">
        {groupedSources.map(({ category, sources: categorySources }) => (
          <section class="source-group" aria-labelledby={category}>
            <div class="group-heading">
              <h2 id={category}>{category}</h2>
              <span>{categorySources.length} 個來源</span>
            </div>

            <div class="source-grid">
              {categorySources.map((source) => (
                <article class="source-card">
                  <div class="card-heading">
                    <h3>{source.name}</h3>
                    {source.official && <span class="official-badge">官方</span>}
                  </div>
                  <p class="platform">{source.platform}</p>
                  {(source.accountName || source.accountId) && (
                    <dl class="account-details">
                      {source.accountName && (
                        <div><dt>顯示名稱</dt><dd>{source.accountName}</dd></div>
                      )}
                      {source.accountId && (
                        <div><dt>{source.accountIdLabel ?? "帳號 ID"}</dt><dd>{source.accountId}</dd></div>
                      )}
                    </dl>
                  )}
                  <p class="description">{source.description}</p>
                  {source.url ? (
                    <a
                      class="source-link"
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >前往來源 <span aria-hidden="true">↗</span></a>
                  ) : (
                    <span class="pending-link">連結待補</span>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">陳偉霆資料庫 · William Chan Archive</p>
        <FooterSocialLinks />
        <p>非官方粉絲資料庫</p>
        <p>本站內容僅作資料整理與記錄用途。</p>
        <p class="footer-copyright">© 2026 William Chan Archive</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background: #f8f6f3;
    color: #292624;
    font-family: "Noto Sans TC", "Noto Sans JP", Arial, sans-serif;
  }

  main { width: min(88%, 1040px); margin: 0 auto; padding: 50px 0 84px; }
  .back { display: inline-block; margin-bottom: 30px; color: #77706b; text-decoration: none; }
  .back:hover { color: #3e3936; }
  .site-identity { margin: -18px 0 28px; color: #958d87; font-size: 13px; letter-spacing: .3px; }
  .page-header { max-width: 760px; margin-bottom: 34px; }
  .eyebrow { margin: 0 0 10px; color: #9b7162; font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  h1 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(40px, 6vw, 64px); font-weight: 500; letter-spacing: -.035em; }
  .intro { margin: 18px 0 0; color: #716b67; font-size: 15px; line-height: 1.85; }

  .category-nav { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 48px; padding: 16px; border: 1px solid #ddd7d2; border-radius: 14px; background: #fff; }
  .category-nav a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 11px; border-radius: 999px; background: #f2eeeb; color: #5e5651; font-size: 13px; text-decoration: none; }
  .category-nav a:hover { background: #e8e1dc; }
  .category-nav span { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: #fff; color: #8a7d75; font-size: 11px; }

  .source-groups { display: grid; gap: 52px; }
  .source-group { scroll-margin-top: 24px; }
  .group-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 17px; padding-bottom: 12px; border-bottom: 1px solid #d8d1cc; }
  .group-heading h2 { margin: 0; font-family: Georgia, "Noto Serif TC", serif; font-size: 25px; font-weight: 500; }
  .group-heading > span { flex: none; color: #948a84; font-size: 12px; }
  .source-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .source-card { display: flex; min-height: 220px; flex-direction: column; padding: 24px; border: 1px solid #ddd7d2; border-radius: 14px; background: #fff; box-shadow: 0 5px 18px rgb(64 51 43 / 5%); }
  .card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .card-heading h3 { margin: 0; font-size: 18px; line-height: 1.5; }
  .official-badge { flex: none; padding: 4px 8px; border-radius: 999px; background: #e8eee7; color: #456047; font-size: 11px; font-weight: 700; letter-spacing: .06em; }
  .platform { margin: 8px 0 0; color: #9b7162; font-size: 12px; font-weight: 700; letter-spacing: .06em; }
  .account-details { display: grid; gap: 5px; margin: 16px 0 0; padding: 12px; border-radius: 9px; background: #f8f6f3; }
  .account-details div { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 8px; font-size: 12px; line-height: 1.5; }
  .account-details dt { color: #948a84; }
  .account-details dd { min-width: 0; margin: 0; overflow-wrap: anywhere; color: #554f4b; }
  :global(.account-details a[x-apple-data-detectors]) {
    color: inherit !important;
    font: inherit !important;
    text-decoration: none !important;
    pointer-events: none;
  }
  .description { margin: 18px 0 24px; color: #706965; font-size: 14px; line-height: 1.75; }
  .source-link, .pending-link { margin-top: auto; font-size: 13px; font-weight: 700; }
  .source-link { align-self: flex-start; color: #5f514a; text-decoration-color: #c8b9b1; text-underline-offset: 4px; }
  .source-link:hover { color: #2f2926; }
  .pending-link { color: #aaa19b; }

  .site-footer { padding: 32px 8%; border-top: 4px solid #d8d0ca; background: #675f5a; color: #e3ddd8; }
  .footer-inner { width: 100%; max-width: 1040px; margin: 0 auto; }
  .site-footer p { margin: 6px 0; font-size: 14px; line-height: 1.55; }
  .site-footer .footer-title { margin-top: 0; color: #f5f1ee; font-weight: 600; }
  .footer-copyright { margin-bottom: 0; color: #c6bdb7; }

  @media (max-width: 680px) {
    main { width: min(88%, 560px); padding: 36px 0 60px; }
    .source-grid { grid-template-columns: 1fr; }
    .source-card { min-height: 0; padding: 20px; }
    .category-nav { margin-bottom: 38px; padding: 12px; }
    .source-groups { gap: 42px; }
    .site-footer { padding: 24px 6%; }
    .site-footer p { font-size: 13px; }
  }
</style>
