---
import { fanActivities } from "../data/fanActivities";

const activitiesByYear = [...fanActivities]
  .sort((a, b) => b.date.localeCompare(a.date))
  .reduce<Record<string, typeof fanActivities>>((groups, activity) => {
    const year = activity.date.slice(0, 4);
    (groups[year] ??= []).push(activity);
    return groups;
  }, {});
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ウィリアム・チャン推し活 IN OSAKA（仮） | 陳偉霆資料庫</title>
  </head>

  <body>
    <main>
      <a href="/" class="back">← 返回首頁</a>
      <p class="site-identity">陳偉霆資料庫 · William Chan Archive</p>

      <header>
        <h1>ウィリアム・チャン推し活 IN OSAKA（仮）</h1>
        <p>活動・應援・聚會・遠征記錄</p>
      </header>

      <section class="group-introduction" aria-labelledby="introduction-heading">
        <h2 id="introduction-heading">グループ紹介</h2>

        <article lang="ja">
          <h3>ウィリアム・チャン推し活 IN OSAKA（仮）</h3>
          <p>2023年10月1日設立。</p>
          <p>
            ウィリアム・チャン（陳偉霆）のオフィシャルファンクラブイベントに参加し、誕生日祝いのビデオ撮影を行ったことをきっかけに、4人から活動を始めました。
          </p>
          <p>
            ウィリアム君の最新情報やライブ・イベント情報を共有したり、映像作品の鑑賞会、誕生日のお祝い、遠征、ゆかりの地を巡る活動などを通して、それぞれのペースで推し活を楽しんでいます。
          </p>
          <p>
            推しについて語り合える仲間との出会いや、普段なら知り合う機会のなかった人たちとの交流も、推し活の大切な楽しみのひとつです。
          </p>
          <p class="motto"><strong>逢う・触れる・染まる・広める・感じる。</strong></p>
          <p>
            ライブや作品を楽しみ、関連する場所を訪れ、好きなものを身につけ、SNSで魅力を伝え、ときには静かに想う。そんなさまざまな形で、ウィリアム・チャンを応援しています。
          </p>

          <footer class="source-note">
            <h4>來源與記錄</h4>
            <p>初出：note（2025年5月18日）</p>
            <p>
              原文：<a
                href="https://note.com/kk_kyoto_vv/n/n78abee2c04d3?sub_rt=share_b"
                target="_blank"
                rel="noopener noreferrer"
              >note 文章 ↗</a>
            </p>
            <p>記録：Kyohko</p>
          </footer>
        </article>
      </section>

      <section class="activity-records" aria-labelledby="activity-records-heading">
        <h2 id="activity-records-heading">活動記錄</h2>

        {Object.keys(activitiesByYear).length === 0 ? (
          <p class="empty-state">目前尚無活動記錄。</p>
        ) : (
          Object.entries(activitiesByYear).map(([year, activities]) => (
            <section class="activity-year" aria-labelledby={`activities-${year}`}>
              <h3 id={`activities-${year}`}>{year}</h3>
              <div class="activity-list">
                {activities.map((activity) => (
                  <article class="activity-entry">
                    <time datetime={activity.date}>{activity.date}</time>
                    <h4>{activity.title}</h4>
                    <dl>
                      {activity.location && (
                        <div>
                          <dt>地點</dt>
                          <dd>{activity.location}</dd>
                        </div>
                      )}
                      <div>
                        <dt>類型</dt>
                        <dd>{activity.category}</dd>
                      </div>
                      {activity.participants && (
                        <div>
                          <dt>參加</dt>
                          <dd>{activity.participants}</dd>
                        </div>
                      )}
                    </dl>
                    <p class="activity-description">{activity.description}</p>
                    {activity.detailUrl && (
                      <a class="read-more" href={activity.detailUrl}>閱讀全文 →</a>
                    )}
                    {activity.source && (
                      <footer class="activity-source">
                        <p>
                          原文來源：<a href={activity.source.url} target="_blank" rel="noopener noreferrer">note 文章 ↗</a>
                        </p>
                        <p>初出日期：{activity.source.publishedAt}</p>
                        <p>記録者：{activity.source.recorder}</p>
                      </footer>
                    )}
                  </article>
                ))}
              </div>
            </section>
          ))
        )}
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">陳偉霆資料庫 · William Chan Archive</p>
        <p class="footer-nav">Timeline ｜ Works ｜ People &amp; Characters ｜ Sources</p>
        <p>非官方粉絲資料庫</p>
        <p>本站內容僅作資料整理與記錄用途。</p>
        <p class="footer-copyright">© 2026 William Chan Archive</p>
      </div>
    </footer>
  </body>

