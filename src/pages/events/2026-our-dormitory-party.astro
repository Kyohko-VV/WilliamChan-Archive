---
import EventGallery from "../../components/events/EventGallery.astro";
import EventSection from "../../components/events/EventSection.astro";
import EventVideos from "../../components/events/EventVideos.astro";
import EventLayout from "../../layouts/EventLayout.astro";

const imageUrl = "https://media.williamchanfanpage.com/events/2026-dormitory/events2026-dormitory-01.jpg";
const imageSourceUrl = "https://weibo.com/3270824053/5335751204278142";
const videoUrl = "https://youtu.be/Tq86F282O5U?si=G6JT6fcMKc1-S6b2";
const gallery = [{
  title: "",
  image: imageUrl,
  source: "英皇娛樂－北京（官方微博）",
  sourceUrl: imageSourceUrl,
  alt: "《我們的宿舍》節目相關官方宣傳圖片",
  ariaLabel: "開啟英皇娛樂－北京官方原圖",
  hideTitle: true,
  sourcePrefix: "圖片來源：",
  sourceSuffix: " →",
}];
const officialSources = [
  { title: "《我們的宿舍》官方微博", url: "https://weibo.com/8004185272/5335770996937053" },
  { title: "英皇娛樂－北京官方微博", url: imageSourceUrl },
  {
    title: "w-Daily／陳偉霆工作室（官方微博）",
    description: "《我們的宿舍》宿舍友情 Party 宣傳",
    url: "https://weibo.com/6269525799/5335751145295252",
  },
];
---

<EventLayout
  pageTitle="《我們的宿舍》 | 陳偉霆資料庫"
  description="2026年8月25日，《我們的宿舍》以朋友相聚為主題，陳偉霆與其他嘉賓一同回憶初識，並回望《老九門》播出十年來的變化。"
  date="2026年8月25日"
  dateTime="2026-08-25"
  title="《我們的宿舍》"
  category="綜藝／節目"
>
  <EventSection id="activity-heading" title="基本活動資訊">
    <dl>
      <div><dt>節目</dt><dd>《我們的宿舍》</dd></div>
      <div><dt>本期主題</dt><dd>朋友相聚</dd></div>
      <div><dt>內容</dt><dd>回憶初識，以及回望《老九門》播出十年來的變化</dd></div>
    </dl>
    <p class="summary has-top-spacing">
      2026年8月25日，《我們的宿舍》官方微博及英皇娛樂－北京陸續發布節目相關內容。本期節目以朋友相聚為主題，陳偉霆與其他嘉賓一同參與節目，內容亦提及回憶初識，以及回望《老九門》播出十年來的變化。節目完整內容已於官方 YouTube 頻道公開。
    </p>
  </EventSection>

  <EventGallery items={gallery} title="圖片" englishLabel="" contained />

  <EventVideos title="影片" englishLabel="">
    <div class="video-frame">
      <iframe
        src="https://www.youtube.com/embed/Tq86F282O5U"
        title="《我們的宿舍》完整節目"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
    <dl class="video-details">
      <div><dt>標題</dt><dd>《我們的宿舍》完整節目</dd></div>
      <div><dt>平台</dt><dd>YouTube</dd></div>
      <div><dt>來源</dt><dd>你好，星期六 Hello Saturday Official（官方 YouTube 頻道）</dd></div>
    </dl>
    <a href={videoUrl} target="_blank" rel="noopener noreferrer">在 YouTube 觀看完整節目 →</a>

    <div class="additional-video">
      <div class="video-frame">
        <iframe
          src="https://www.youtube.com/embed/rPGmRnYdp1g"
          title="《我們的宿舍·歸心季》宿舍不熄燈 EP14"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
      <dl class="video-details">
        <div><dt>標題</dt><dd>《我們的宿舍·歸心季》宿舍不熄燈 EP14</dd></div>
        <div><dt>平台</dt><dd>YouTube</dd></div>
        <div><dt>來源</dt><dd>你好，星期六 Hello Saturday Official（官方 YouTube 頻道）</dd></div>
        <div><dt>標記</dt><dd>追加版／延伸內容</dd></div>
      </dl>
      <a
        href="https://youtu.be/rPGmRnYdp1g?si=bYvjuD6R2JQr1Lnh"
        target="_blank"
        rel="noopener noreferrer"
      >在 YouTube 開啟 →</a>
    </div>
  </EventVideos>

  <EventSection id="sources-heading" title="官方來源">
    <ul class="source-list">
      {officialSources.map((source) => (
        <li>
          <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} →</a>
          {source.description && <p>{source.description}</p>}
        </li>
      ))}
    </ul>
  </EventSection>
</EventLayout>

<style>
  .additional-video {
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid #e5e1dc;
  }
</style>
