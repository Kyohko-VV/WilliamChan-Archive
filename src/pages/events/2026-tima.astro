    }

    .video-list {
      display: grid;
      gap: 16px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .video-list li {
      padding-bottom: 16px;
      border-bottom: 1px solid #e5e1dc;
    }

    .video-list li:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .video-list p {
      margin-top: 6px;
      color: #77706b;
      font-size: 14px;
    }

    .empty-state {
      margin: 0;
      color: #958d87;
    }

    @media (min-width: 701px) {
      .gallery-grid {
        display: block;
      }

      .gallery-item {
        display: none;
      }

      .gallery-item.is-active {
        display: block;
      }

      .gallery-image-link {
        background: #f8f6f3;
        border-radius: 8px;
      }

      .gallery-item img {
        height: min(65vh, 640px);
        object-fit: contain;
        object-position: center;
      }

      .gallery-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 20px;
      }

      .gallery-controls button {
        padding: 9px 14px;
        background: #ffffff;
        border: 1px solid #d8d0ca;
        border-radius: 8px;
        color: #675f5a;
        font: inherit;
        cursor: pointer;
      }

      .gallery-controls button:hover,
      .gallery-controls button:focus-visible {
        border-color: #a99f98;
      }

      .gallery-counter {
        margin: 0;
        color: #77706b;
        font-variant-numeric: tabular-nums;
      }
    }

    .site-footer {
      margin-top: 24px;
      padding: 32px 8%;
