---
import EventGallery from "../../components/events/EventGallery.astro";
import EventSection from "../../components/events/EventSection.astro";
import EventVideos from "../../components/events/EventVideos.astro";
import EventLayout from "../../layouts/EventLayout.astro";

interface GalleryItem { title: string; image: string; source: string; sourceUrl: string; }
interface VideoItem { title: string; platform: string; url: string; source: string; }

const gallery: GalleryItem[] = [
  { title: "", image: "https://media.williamchanfanpage.com/events/2026-tima/006Qii3Rgy1ige3vbhhbhj36qo8zk7wj.jpg", source: "英皇娛樂－北京（官方微博）", sourceUrl: "https://weibo.com/3270824053/ReLCagXPd" },
  { title: "", image: "https://media.williamchanfanpage.com/events/2026-tima/006Qii3Rgy1ige4s305axj30qv0zt7kg.jpg", source: "w-Daily／陳偉霆工作室（官方微博）", sourceUrl: "https://weibo.com/6269525799/ReLNXtGia" },
  { title: "", image: "https://media.williamchanfanpage.com/events/2026-tima/c2f4d075ly1iget3urpg4j267y45du14.jpg", source: "英皇娛樂－北京（官方微博）", sourceUrl: "https://weibo.com/3270824053/ReRjPxOwS" },
  { title: "", image: "https://media.williamchanfanpage.com/events/2026-tima/c2f4d075ly1iget3xktexj235s23w7wi.jpg", source: "英皇娛樂－北京（官方微博）", sourceUrl: "https://weibo.com/3270824053/ReRjPxOwS" },
  { title: "", image: "https://media.williamchanfanpage.com/events/2026-tima/c2f4d075ly1iget43k4p9j245c67wx6x.jpg", source: "英皇娛樂－北京（官方微博）", sourceUrl: "https://weibo.com/3270824053/ReRjPxOwS" },
];

const videos: VideoItem[] = [
  { title: "2026 TIMA 舞台合集", platform: "YouTube", url: "https://youtu.be/OemxuodgRmY", source: "KYOHKOの推し活（YouTube）" },
  { title: "TIMA 彩排碎片", platform: "微博", url: "https://weibo.com/3270824053/ReK8Nx0Bp", source: "英皇娛樂－北京（官方微博）" },
  { title: "TIMA 彩排小片預覽", platform: "微博", url: "https://weibo.com/6269525799/ReK7Vc3zo", source: "w-Daily／陳偉霆工作室（官方微博）" },
  { title: "《戰士》TIMA 舞台直拍", platform: "微博", url: "https://weibo.com/6269525799/ReLJU6rRX", source: "w-Daily／陳偉霆工作室（官方微博）" },
  { title: "TIMA 現場舞台片段", platform: "微博", url: "https://weibo.com/5103645868/ReKIkrL36?refer_flag=1001030103_", source: "星姐微博（媒體來源）" },
];
---

<EventLayout
  pageTitle="2026 TIMA｜獲「年度亞洲跨界藝人」並帶來五首舞台 | 陳偉霆資料庫"
  description="陳偉霆於2026 TIMA國際音樂大賞獲年度亞洲跨界藝人，並帶來五首舞台。"
  date="2026年8月23日"
  dateTime="2026-08-23"
  title="2026 TIMA｜獲「年度亞洲跨界藝人」並帶來五首舞台"
  location="香港・啟德主場館"
>
  <EventSection id="summary-heading" title="活動簡介">
    <p class="summary">
      2026年8月23日，陳偉霆出席於香港啟德主場館舉行的「2026 TIMA國際音樂大賞」，獲頒「年度亞洲跨界藝人」。當晚帶來《女皇》《Love U2》《樂此不疲》《哪怕我們》《戰士》五首舞台，其中《哪怕我們》以結他自彈自唱形式演出；《戰士》的舞台中則融入《九門》「窄娘娘」相關造型元素。銀髮造型也成為當晚極具記憶點的一幕。久違再次在香港大型舞台上，以歌手身份完整呈現音樂與舞台魅力，這一晚很值得留下紀錄。
    </p>
  </EventSection>

  <EventSection id="setlist-heading" title="舞台曲目">
    <ol class="setlist">
      <li>《女皇》</li>
      <li>《Love U2》</li>
      <li>《樂此不疲》</li>
      <li>《哪怕我們》 <span>— 結他自彈自唱</span></li>
      <li>《戰士》 <span>— 舞台中呈現《九門》「窄娘娘」相關造型元素</span></li>
    </ol>
  </EventSection>

  <EventGallery items={gallery} />
  <EventVideos>
    <article class="youtube-video">
      <h3>{videos[0].title}</h3>
      <div class="youtube-video__player">
        <iframe
          src="https://www.youtube.com/embed/OemxuodgRmY"
          title="2026 TIMA 舞台合集"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
      <p>{videos[0].source}</p>
      <a href={videos[0].url} target="_blank" rel="noopener noreferrer">在 YouTube 開啟 →</a>
    </article>

    <ul class="video-list">
      {videos.slice(1).map((video) => (
        <li>
          <a href={video.url} target="_blank" rel="noopener noreferrer">{video.title}</a>
          <p>{video.platform} · 來源：{video.source}</p>
        </li>
      ))}
    </ul>
  </EventVideos>

  <EventSection id="sources-heading" title="來源與記錄">
    <div class="source-group">
      <h3>獲獎與活動總結</h3>
      <ul class="video-list">
        <li><a href="https://weibo.com/3270824053/ReRjPxOwS" target="_blank" rel="noopener noreferrer">英皇娛樂－北京</a><p>獲獎祝賀</p></li>
        <li><a href="https://weibo.com/6269525799/ReRjgCntv" target="_blank" rel="noopener noreferrer">w-Daily／陳偉霆工作室</a><p>獲獎及五首舞台總結</p></li>
      </ul>
    </div>

    <div class="source-group">
      <h3>造型與 Look</h3>
      <ul class="video-list">
        <li><a href="https://weibo.com/3270824053/ReLCagXPd" target="_blank" rel="noopener noreferrer">英皇娛樂－北京</a><p>TIMA 銀髮 Look</p></li>
        <li><a href="https://weibo.com/6269525799/ReLBpafY0" target="_blank" rel="noopener noreferrer">w-Daily／陳偉霆工作室</a><p>TIMA 銀髮 Look</p></li>
        <li><a href="https://weibo.com/6269525799/ReKgQserR" target="_blank" rel="noopener noreferrer">w-Daily／陳偉霆工作室</a><p>隱藏款造型預覽</p></li>
      </ul>
    </div>

    <div class="source-group">
      <h3>彩排與幕後記錄</h3>
      <ul class="video-list">
        <li><a href="https://weibo.com/3270824053/ReIsSd9SO" target="_blank" rel="noopener noreferrer">英皇娛樂－北京</a><p>TIMA 彩排現場</p></li>
        <li><a href="https://weibo.com/6269525799/ReIuayjeD" target="_blank" rel="noopener noreferrer">w-Daily／陳偉霆工作室</a><p>舞台花絮</p></li>
        <li><a href="https://weibo.com/6269525799/ReIsFrlBm" target="_blank" rel="noopener noreferrer">w-Daily／陳偉霆工作室</a><p>彩排記錄</p></li>
      </ul>
    </div>
  </EventSection>
</EventLayout>

<style>
  .youtube-video {
    width: 100%;
    max-width: 100%;
    margin-bottom: 1.5rem;
  }

  .youtube-video__player {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .youtube-video__player iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
