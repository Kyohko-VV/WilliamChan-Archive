    }

    .gallery-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .gallery-item {
      margin: 0;
    }

    .gallery-item img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 8px;
    }

    .gallery-image-link {
      display: block;
    }

    .gallery-controls {
      display: none;
    }

    .gallery-item figcaption {
      margin-top: 10px;
