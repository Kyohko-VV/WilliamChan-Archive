---
const officialUrl = "https://www.ch-ginga.jp/detail/taiyoutohoshi/";
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>《太陽と星辰（ほし）－時を越える追跡者－》日本播出開始 | 陳偉霆資料庫</title>
    <meta
      name="description"
      content="《太陽と星辰（ほし）－時を越える追跡者－》自2026年8月26日起於日本チャンネル銀河播出。"
    />
  </head>

  <body>
    <main>
      <a href="/timeline" class="back">← 返回時間線</a>
      <p class="site-identity">陳偉霆資料庫 · William Chan Archive</p>

      <header>
        <p class="event-date"><time datetime="2026-08-26">2026年8月26日</time></p>
        <h1>《太陽と星辰（ほし）－時を越える追跡者－》日本播出開始</h1>
        <p class="category">電視劇／日本播出</p>
      </header>

      <section aria-labelledby="broadcast-heading">
        <h2 id="broadcast-heading">基本播出資訊</h2>
        <dl>
          <div><dt>播出頻道</dt><dd>チャンネル銀河</dd></div>
          <div><dt>播出期間</dt><dd>2026年8月26日～9月18日</dd></div>
          <div><dt>播出時間</dt><dd>週一～週五 24:00～25:00（日本時間）</dd></div>
          <div><dt>集數</dt><dd>全18集</dd></div>
        </dl>
      </section>

      <section aria-labelledby="sources-heading">
        <h2 id="sources-heading">官方來源</h2>
        <a href={officialUrl} target="_blank" rel="noopener noreferrer">
          チャンネル銀河 節目官方頁面 →
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">陳偉霆資料庫 · William Chan Archive</p>
        <p class="footer-nav">Timeline ｜ Works ｜ People &amp; Characters ｜ Sources</p>
        <p>非官方粉絲資料庫</p>
        <p>本站內容僅作資料整理與記錄用途。</p>
        <p class="footer-copyright">© 2026 William Chan Archive</p>
      </div>
    </footer>
  </body>

  <style>
    :global(*) { box-sizing: border-box; }
    :global(body) {
      margin: 0;
      background: #f8f6f3;
      color: #292624;
      font-family: "Noto Sans TC", "Noto Sans JP", Arial, sans-serif;
    }
    main { width: 88%; max-width: 960px; margin: 0 auto; padding: 50px 0 80px; }
    .back { display: inline-block; margin-bottom: 30px; color: #77706b; text-decoration: none; }
    .site-identity { margin: -18px 0 28px; color: #958d87; font-size: 13px; }
    header { margin-bottom: 35px; }
    .event-date, .category { margin: 0; color: #77706b; line-height: 1.6; }
    h1 { margin: 8px 0 12px; font-size: 36px; line-height: 1.35; }
    section {
      margin-top: 24px;
      padding: 28px;
      background: #fff;
      border: 1px solid #e5e1dc;
      border-radius: 12px;
    }
    section h2 { margin: 0 0 20px; font-size: 22px; }
    dl { margin: 0; }
    dl div { display: grid; grid-template-columns: 7rem 1fr; gap: 16px; padding: 10px 0; }
    dt { color: #77706b; }
    dd { margin: 0; color: #4f4945; }
    section a { color: #675f5a; }
    .site-footer {
      margin-top: 24px;
      padding: 32px 8%;
      background: #675f5a;
      border-top: 4px solid #d8d0ca;
      color: #e3ddd8;
    }
    .footer-inner { width: 100%; max-width: 1100px; margin: 0 auto; }
    .site-footer p { margin: 6px 0; font-size: 14px; line-height: 1.55; }
    .site-footer .footer-title { margin-top: 0; color: #f5f1ee; font-weight: 600; }
    .footer-nav { overflow-wrap: anywhere; }
    .footer-copyright { margin-bottom: 0; color: #c6bdb7; }
    @media (max-width: 700px) {
      main { padding: 30px 0 50px; }
      h1 { font-size: 28px; }
      section { padding: 20px; }
      dl div { grid-template-columns: 1fr; gap: 4px; }
      .site-footer { margin-top: 10px; padding: 22px 6%; }
      .site-footer p { margin: 4px 0; font-size: 13px; line-height: 1.45; }
    }
  </style>
</html>
