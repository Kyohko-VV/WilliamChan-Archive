---
import EventSection from "../../components/events/EventSection.astro";
import EventLayout from "../../layouts/EventLayout.astro";

const officialUrl = "https://www.ch-ginga.jp/detail/taiyoutohoshi/";
---

<EventLayout
  pageTitle="《太陽と星辰（ほし）－時を越える追跡者－》日本再次播出開始 | 陳偉霆資料庫"
  description="《太陽と星辰（ほし）－時を越える追跡者－》自2026年8月26日起於日本チャンネル銀河播出。"
  date="2026年8月26日"
  dateTime="2026-08-26"
  title="《太陽と星辰（ほし）－時を越える追跡者－》日本再次播出開始"
  category="電視劇／日本播出"
>
  <EventSection id="broadcast-heading" title="基本播出資訊">
    <dl>
      <div><dt>播出頻道</dt><dd>チャンネル銀河</dd></div>
      <div><dt>播出期間</dt><dd>2026年8月26日～9月18日</dd></div>
      <div><dt>播出時間</dt><dd>週一～週五 24:00～25:00（日本時間）</dd></div>
      <div><dt>集數</dt><dd>全18集</dd></div>
    </dl>
  </EventSection>

  <EventSection id="sources-heading" title="官方來源">
    <a href={officialUrl} target="_blank" rel="noopener noreferrer">
      チャンネル銀河 節目官方頁面 →
    </a>
  </EventSection>
</EventLayout>
